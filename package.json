{
  "name": "tka-rehab-platform",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "check:status": "node scripts/check-project-status.mjs",
    "test:runtime": "node --import tsx --test src/lib/access-control.test.ts src/lib/ai-evidence.test.ts src/lib/api-errors.test.ts src/lib/auth.test.ts src/lib/env.test.ts src/lib/evidence-package.test.ts src/lib/gateway-auth.test.ts src/lib/local-auth.test.ts src/lib/patient-access.test.ts src/lib/rate-limit.test.ts src/lib/registration-auth.test.ts src/lib/rehab-metrics.test.ts src/lib/request-limits.test.ts src/lib/request-security.test.ts src/lib/sensor-ingestion.test.ts src/lib/sensor-ingestion.integration.test.ts",
    "gateway:test": "node --import tsx --test hardware-gateway/protocol/wit-standard.test.ts hardware-gateway/offline-queue.test.ts hardware-gateway/ble-sdk-adapter.test.ts hardware-gateway/gateway.test.ts hardware-gateway/sample-provenance.test.ts",
    "api:test": "node --import tsx --test src/app/api/gateway/ready/route.test.ts src/app/api/hardware-simulator/route.test.ts src/app/api/knee-records/route.test.ts src/app/api/sensor-samples/route.test.ts src/app/api/sensor-samples/batch/route.test.ts",
    "test": "npm run test:runtime && npm run gateway:test && npm run api:test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.11.0",
    "next": "^15.5.22",
    "pg": "^8.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
