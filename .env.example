# demo: in-memory presentation data, cookie role login, no durable storage
# production: requires DATABASE_URL, gateway auth, and complete local or Supabase auth
APP_MODE="demo"
AUTH_MODE="local"
GATEWAY_API_TOKEN="replace-with-at-least-24-random-characters"
LOCAL_AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
LOCAL_FAMILY_EMAIL="family@example.com"
LOCAL_FAMILY_PASSWORD="replace-with-at-least-12-characters"
LOCAL_NURSE_EMAIL="nurse@example.com"
LOCAL_NURSE_PASSWORD="replace-with-at-least-12-characters"
NEXT_PUBLIC_REGISTRATION_ENABLED="false"
RESEND_API_KEY="re_replace-with-resend-api-key"
EMAIL_FROM="TKA 康复平台 <verify@updates.example.com>"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Manual, quality-gated rehabilitation analysis via an OpenAI-compatible Responses API.
# Keep credentials server-side. Never place them in NEXT_PUBLIC_* variables.
AI_RESPONSES_BASE_URL="https://api.openai.com"
AI_RESPONSES_MODEL="gpt-5.5"
AI_RESPONSES_REASONING_EFFORT="xhigh"
AI_RESPONSES_API_KEY="your-provider-api-key"
AI_RESPONSES_ACTOR_AUTHORIZATION=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DOMAIN="www.example.com"
ROOT_DOMAIN="example.com"
