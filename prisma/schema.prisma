generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SurgicalSide {
  LEFT
  RIGHT
  BILATERAL
}

enum PatientStatus {
  ACTIVE
  OBSERVATION
  DISCHARGED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DeviceSource {
  SMART_BRACE
  HARDWARE
  MANUAL
  DEMO
}

enum DeviceStatus {
  UNBOUND
  ONLINE
  OFFLINE
  LOW_BATTERY
}

enum DevicePlacement {
  THIGH
  SHANK
  BRACE
  UNKNOWN
}

enum SensorSessionStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum CalibrationQuality {
  PENDING
  GOOD
  FAIR
  POOR
}

enum AlertType {
  ROM_LOW
  ACTIVITY_LOW
  DURATION_LOW
  PAIN_HIGH
  DEVICE_OFFLINE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NursingAction {
  REMOTE_GUIDANCE
  PHONE_CALL
  HOME_VISIT
  REHAB_ADJUSTMENT
  MEDICATION_REMINDER
}

enum UserRole {
  patient
  nurse
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum VerificationPurpose {
  REGISTRATION
  RESET_PASSWORD
}

enum PatientInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PatientAccessAction {
  SELF_CREATED
  INVITE_CREATED
  INVITE_ACCEPTED
  INVITE_REVOKED
  FAMILY_UNLINKED
  NURSE_REVOKED
  MIGRATED
  PATIENT_UPDATED
  NURSE_ASSIGNED
  NURSE_RELEASED
  GATEWAY_ISSUED
  GATEWAY_REVOKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AllergyStatus {
  UNKNOWN
  NONE
  PRESENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  patientId           String?  @map("patient_id")
  role                UserRole
  name                String
  age                 Int?
  gender              Gender?
  tkaSurgeryDate      DateTime? @map("tka_surgery_date")
  affectedKnee        SurgicalSide? @map("affected_knee")
  phone               String?
  emergencyContact    String?  @map("emergency_contact")
  relationToPatient   String?  @map("relation_to_patient")
  notificationPreference String? @map("notification_preference")
  sensorDeviceId      String?  @map("sensor_device_id")
  department          String?
  title               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  patient             Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([patientId])
  @@map("profiles")
}

model AuthAccount {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(patient)
  status       AccountStatus @default(ACTIVE)
  verifiedAt   DateTime      @map("verified_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([role, status])
  @@map("auth_accounts")
}

model EmailVerification {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose @default(REGISTRATION)
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model AiAnalysis {
  id                String   @id @default(cuid())
  patientId         String   @map("patient_id")
  patientName       String   @map("patient_name")
  sessionId         String?  @map("session_id")
  confidence        Float?
  status            String?
  flexionAngle      Float    @map("flexion_angle")
  activityFrequency Int      @map("activity_frequency")
  activityDuration  Int      @map("activity_duration")
  painScore         Int      @default(0) @map("pain_score")
  provider          String
  report            String
  recommendation    String
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@index([sessionId])
  @@map("ai_analyses")
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String?           @map("patient_id")
  patientName     String            @map("patient_name")
  patientPhone    String?           @map("patient_phone")
  expectedTime    DateTime          @map("expected_time")
  description     String
  status          AppointmentStatus @default(PENDING)
  nurseName       String?           @map("nurse_name")
  scheduledTime   DateTime?         @map("scheduled_time")
  responseNote    String?           @map("response_note")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([status, expectedTime])
  @@index([patientId, createdAt])
  @@map("appointments")
}

model Patient {
  id               String           @id @default(cuid())
  medicalRecordNo  String           @unique @map("medical_record_no")
  name             String
  age              Int
  gender           Gender?
  dateOfBirth      DateTime?        @map("date_of_birth")
  ethnicity        String?
  nativePlace      String?          @map("native_place")
  nationality      String?
  maritalStatus    String?          @map("marital_status")
  occupation       String?
  bloodType        String?          @map("blood_type")
  roomNumber       String?          @map("room_number")
  phone            String?
  emergencyContact String?          @map("emergency_contact")
  homeAddress      String?          @map("home_address")
  emergencyContactName String?      @map("emergency_contact_name")
  emergencyContactRelation String?  @map("emergency_contact_relation")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  allergyStatus    AllergyStatus    @default(UNKNOWN) @map("allergy_status")
  allergyHistory   String?          @map("allergy_history")
  pastMedicalHistory String?        @map("past_medical_history")
  surgicalHistory String?           @map("surgical_history")
  familyMedicalHistory String?      @map("family_medical_history")
  medicationHistory String?         @map("medication_history")
  surgeryDate      DateTime         @map("surgery_date")
  surgicalSide     SurgicalSide     @default(RIGHT) @map("surgical_side")
  diagnosis        String           @default("TKA 术后康复")
  targetFlexion    Float            @default(110) @map("target_flexion")
  status           PatientStatus    @default(ACTIVE)
  riskLevel        RiskLevel        @default(MEDIUM) @map("risk_level")
  primaryNurseUserId String?         @map("primary_nurse_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  kneeDataRecords  KneeDataRecord[]
  nursingRecords   NursingRecord[]
  alertLogs        AlertLog[]
  deviceBindings   DeviceBinding[]
  sensorSessions   SensorSession[]
  sensorSamples    SensorSample[]
  calibrationRecords CalibrationRecord[]
  profiles         Profile[]
  appointments     Appointment[]
  invitations      PatientInvitation[]
  accessAudits     PatientAccessAudit[]
  gatewayCredentials GatewayCredential[]

  @@index([status, riskLevel])
  @@index([primaryNurseUserId, status])
  @@map("patients")
}

model PatientInvitation {
  id              String                  @id @default(cuid())
  patientId       String?                 @map("patient_id")
  codeHash        String                  @unique @map("code_hash")
  status          PatientInvitationStatus @default(PENDING)
  createdByUserId String                  @map("created_by_user_id")
  acceptedByUserId String?                @map("accepted_by_user_id")
  acceptedAt      DateTime?               @map("accepted_at")
  revokedAt       DateTime?               @map("revoked_at")
  expiresAt       DateTime                @map("expires_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  patient         Patient?                @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status, createdAt])
  @@index([expiresAt, status])
  @@map("patient_invitations")
}

model PatientAccessAudit {
  id          String              @id @default(cuid())
  patientId   String              @map("patient_id")
  userId      String              @map("user_id")
  action      PatientAccessAction
  actorUserId String              @map("actor_user_id")
  actorRole   UserRole            @map("actor_role")
  details     Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@map("patient_access_audits")
}

model GatewayCredential {
  id            String   @id @default(cuid())
  tokenHash     String   @unique @map("token_hash")
  patientId     String   @map("patient_id")
  deviceSerials String[] @map("device_serials")
  label         String
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, revokedAt])
  @@map("gateway_credentials")
}

model Device {
  id             String         @id @default(cuid())
  serialNo       String         @unique @map("serial_no")
  ownerPatientId String?        @map("owner_patient_id")
  name           String
  model          String         @default("WT9011DCL-BT50")
  manufacturer   String         @default("WitMotion")
  status         DeviceStatus   @default(UNBOUND)
  deviceToken    String?        @unique @map("device_token")
  firmwareVersion String?       @map("firmware_version")
  batteryLevel   Int?           @map("battery_level")
  signalStrength Int?           @map("signal_strength")
  lastSeenAt     DateTime?      @map("last_seen_at")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  bindings       DeviceBinding[]
  samples        SensorSample[]
  thighCalibrations CalibrationRecord[] @relation("ThighCalibrationDevice")
  shankCalibrations CalibrationRecord[] @relation("ShankCalibrationDevice")

  @@index([status, lastSeenAt])
  @@map("devices")
}

model DeviceBinding {
  id                String          @id @default(cuid())
  deviceId          String          @map("device_id")
  patientId         String          @map("patient_id")
  placement         DevicePlacement @default(UNKNOWN)
  placementRevision Int             @default(0) @map("placement_revision")
  active            Boolean         @default(true)
  boundAt           DateTime        @default(now()) @map("bound_at")
  unboundAt         DateTime?       @map("unbound_at")
  device            Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, active])
  @@index([patientId, placementRevision, active])
  @@index([deviceId, active])
  @@map("device_bindings")
}

model SensorSession {
  id                String              @id @default(cuid())
  patientId         String              @map("patient_id")
  placementRevision Int                 @default(0) @map("placement_revision")
  status            SensorSessionStatus @default(ACTIVE)
  source            DeviceSource        @default(HARDWARE)
  startedAt         DateTime            @default(now()) @map("started_at")
  endedAt           DateTime?           @map("ended_at")
  sampleCount       Int                 @default(0) @map("sample_count")
  summary           Json?
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  samples           SensorSample[]
  calibrationRecords CalibrationRecord[]

  @@index([patientId, placementRevision, startedAt])
  @@index([status])
  @@map("sensor_sessions")
}

model SensorSample {
  id              String          @id @default(cuid())
  gatewaySampleId String?         @unique @map("gateway_sample_id")
  sessionId       String?         @map("session_id")
  deviceId        String?         @map("device_id")
  patientId       String          @map("patient_id")
  source          DeviceSource    @default(HARDWARE)
  placement       DevicePlacement @default(UNKNOWN)
  placementRevision Int           @default(0) @map("placement_revision")
  recordedAt      DateTime        @default(now()) @map("recorded_at")
  roll            Float?
  pitch           Float?
  yaw             Float?
  q0              Float?
  q1              Float?
  q2              Float?
  q3              Float?
  ax              Float?
  ay              Float?
  az              Float?
  gx              Float?
  gy              Float?
  gz              Float?
  flexionAngle    Float?          @map("flexion_angle")
  extensionAngle  Float?          @map("extension_angle")
  confidence      Float?
  raw             Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  session         SensorSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device          Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
  @@index([sessionId, placementRevision, recordedAt])
  @@index([deviceId, recordedAt])
  @@map("sensor_samples")
}

model CalibrationRecord {
  id              String             @id @default(cuid())
  patientId       String             @map("patient_id")
  sessionId       String?            @map("session_id")
  thighDeviceId   String?            @map("thigh_device_id")
  shankDeviceId   String?            @map("shank_device_id")
  placementRevision Int              @default(0) @map("placement_revision")
  quality         CalibrationQuality @default(PENDING)
  zeroFlexionAngle Float             @default(0) @map("zero_flexion_angle")
  baseline        Json?
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session         SensorSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  thighDevice     Device?            @relation("ThighCalibrationDevice", fields: [thighDeviceId], references: [id], onDelete: SetNull)
  shankDevice     Device?            @relation("ShankCalibrationDevice", fields: [shankDeviceId], references: [id], onDelete: SetNull)

  @@index([patientId, placementRevision, createdAt])
  @@map("calibration_records")
}

model KneeDataRecord {
  id                String       @id @default(cuid())
  patientId         String       @map("patient_id")
  flexionAngle      Float        @map("flexion_angle")
  extensionAngle    Float        @default(0) @map("extension_angle")
  activityFrequency Int          @map("activity_frequency")
  activityDuration  Int          @map("activity_duration")
  painScore         Int          @default(0) @map("pain_score")
  batteryLevel      Int?         @map("battery_level")
  signalStrength    Int          @default(96) @map("signal_strength")
  source            DeviceSource @default(SMART_BRACE)
  recordedAt        DateTime     @default(now()) @map("recorded_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
  @@map("knee_data_records")
}

model NursingRecord {
  id           String        @id @default(cuid())
  patientId    String        @map("patient_id")
  nurseName    String        @map("nurse_name")
  actionType   NursingAction @default(REMOTE_GUIDANCE) @map("action_type")
  guidance     String
  notes        String?
  nextFollowUp DateTime?     @map("next_follow_up")
  readAt       DateTime?     @map("read_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("nursing_records")
}

model AlertLog {
  id          String        @id @default(cuid())
  patientId   String        @map("patient_id")
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  status      AlertStatus   @default(OPEN)
  title       String
  message     String
  metric      String?
  value       Float?
  threshold   Float?
  createdAt   DateTime      @default(now()) @map("created_at")
  resolvedAt  DateTime?     @map("resolved_at")
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status, severity])
  @@index([createdAt])
  @@map("alert_logs")
}
